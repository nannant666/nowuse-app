<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#10A37F">
<title>Nowuse AI</title>
<style>
  :root{
    --accent:#10A37F;
    --accent-press:#0D8869;
    --bg:#F5F7F7;
    --card:#FFFFFF;
    --text:#101828;
    --muted:#667085;
    --line:rgba(16,24,40,.08);
    --shadow:0 12px 40px rgba(16,24,40,.08);
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#131415;
      --card:#1C1E20;
      --text:#EDEFF2;
      --muted:#8B929C;
      --line:rgba(255,255,255,.08);
      --shadow:0 12px 40px rgba(0,0,0,.4);
    }
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    -webkit-font-smoothing:antialiased;
  }
  .stage{
    width:100%;
    max-width:360px;
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
  }
  .logo{
    width:72px;
    height:72px;
    display:block;
    margin-bottom:18px;
  }
  .brand{
    font-size:17px;
    font-weight:600;
    letter-spacing:.2px;
  }
  .status{
    margin-top:8px;
    font-size:13px;
    color:var(--muted);
    min-height:18px;
  }
  .bar{
    margin-top:20px;
    width:120px;
    height:3px;
    border-radius:3px;
    background:var(--line);
    overflow:hidden;
  }
  .bar i{
    display:block;
    width:44%;
    height:100%;
    border-radius:3px;
    background:var(--accent);
    animation:slide 1.1s ease-in-out infinite;
  }
  @keyframes slide{
    0%{transform:translateX(-100%)}
    100%{transform:translateX(230%)}
  }
  .panel{
    margin-top:22px;
    width:100%;
    background:var(--card);
    border:1px solid var(--line);
    border-radius:16px;
    box-shadow:var(--shadow);
    padding:22px 20px 20px;
    text-align:left;
  }
  .panel h2{
    margin:0 0 10px;
    font-size:16px;
    font-weight:600;
  }
  .panel p{
    margin:0;
    font-size:13.5px;
    line-height:1.65;
    color:var(--muted);
  }
  .ver{
    margin-top:12px;
    font-size:12.5px;
    color:var(--muted);
    font-variant-numeric:tabular-nums;
  }
  .ver b{color:var(--text);font-weight:600}
  .btn{
    display:block;
    width:100%;
    margin-top:16px;
    padding:13px 16px;
    border:0;
    border-radius:11px;
    background:var(--accent);
    color:#fff;
    font-size:15px;
    font-weight:600;
    font-family:inherit;
    cursor:pointer;
  }
  .btn:active{background:var(--accent-press)}
  .btn[disabled]{opacity:.55}
  .hint{
    margin-top:12px!important;
    font-size:12.5px!important;
  }
  .line-item{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    width:100%;
    margin-top:10px;
    padding:13px 14px;
    border:1px solid var(--line);
    border-radius:11px;
    background:transparent;
    color:var(--text);
    font-size:14px;
    font-family:inherit;
    text-align:left;
    cursor:pointer;
  }
  .line-item:active{background:var(--line)}
  .line-item:first-of-type{margin-top:14px}
  .line-item small{
    color:var(--muted);
    font-size:12px;
    font-variant-numeric:tabular-nums;
  }
  .foot{
    margin-top:18px;
    font-size:11.5px;
    color:var(--muted);
    font-variant-numeric:tabular-nums;
  }
</style>
</head>
<body>
  <div class="stage">
    <img class="logo" src="logo.png" alt="">
    <div class="brand">Nowuse AI</div>
    <div class="status" id="status">正在连接…</div>
    <div class="bar" id="bar"><i></i></div>

    <section class="panel" id="updatePanel" hidden>
      <h2 id="uTitle">需要更新</h2>
      <p id="uText"></p>
      <div class="ver" id="uVer"></div>
      <button class="btn" id="uBtn">立即更新</button>
      <p class="hint" id="uHint" hidden></p>
    </section>

    <section class="panel" id="linePanel" hidden>
      <h2>选择线路</h2>
      <p id="lText">正在准备线路…</p>
      <div id="lList"></div>
    </section>

    <div class="foot" id="foot"></div>
  </div>

<script>
(function () {
  'use strict';

  var VERSION = '__APP_VERSION__';
  var IS_ANDROID = /Android/i.test(navigator.userAgent);
  var PLATFORM = IS_ANDROID ? 'android' : 'windows';

  // 配置源：先自有域名，再 GitHub Pages 兜底。任一可用即可。
  var SOURCES = [
    'https://svip.nowuse-ai.com/app/update.js',
    'https://nannant666.github.io/nowuse-app/update.js'
  ];

  // 内置兜底：远程配置全部拿不到时，仍然能进站。
  var FALLBACK = {
    min: '',
    latest: VERSION,
    note: '',
    entries: [
      'https://chat2.nowuse-ai.com/list/',
      'https://chat1.nowuse-ai.com/list/',
      'https://chat3.nowuse-ai.com/list/'
    ],
    download: {}
  };

  var LAST_KEY = 'nowuse.lastEntry';

  var $ = function (id) { return document.getElementById(id); };

  function setStatus(text) { $('status').textContent = text; }
  function stopBar() { $('bar').hidden = true; }

  function hostOf(url) {
    try { return new URL(url).host; } catch (e) { return url; }
  }

  function cmpVersion(a, b) {
    var pa = String(a).split('.'), pb = String(b).split('.');
    for (var i = 0; i < 3; i++) {
      var x = parseInt(pa[i] || '0', 10) || 0;
      var y = parseInt(pb[i] || '0', 10) || 0;
      if (x !== y) return x > y ? 1 : -1;
    }
    return 0;
  }

  // JSONP 方式取配置：file:// 与 tauri:// 下都不受 CORS 限制。
  // 配置脚本调用 window.__NOWUSE_CONFIG__(obj)，结果落在 _cfg。
  var _cfg = null;
  window.__NOWUSE_CONFIG__ = function (cfg) { _cfg = cfg; };

  function loadConfig() {
    return new Promise(function (resolve) {
      var settled = false;
      var pending = SOURCES.length;

      function settle(cfg) {
        if (settled) return;
        if (cfg) {
          settled = true;
          resolve(cfg);
          return;
        }
        pending -= 1;
        if (pending <= 0) {
          settled = true;
          resolve(null);
        }
      }

      // 多源并发：谁先返回用谁，避免主域名没部署时干等超时。
      SOURCES.forEach(function (base) {
        var finished = false;
        var script = document.createElement('script');
        var timer = setTimeout(function () { finish(null); }, 5000);

        function finish(cfg) {
          if (finished) return;
          finished = true;
          clearTimeout(timer);
          script.onload = script.onerror = null;
          if (script.parentNode) script.parentNode.removeChild(script);
          settle(cfg);
        }

        _cfg = null;
        script.onload = function () { finish(_cfg || null); };
        script.onerror = function () { finish(null); };
        script.src = base + '?t=' + Date.now();
        document.head.appendChild(script);
      });
    });
  }

  function showUpdate(cfg) {
    stopBar();
    $('status').textContent = '';
    $('updatePanel').hidden = false;

    var note = cfg.note || '新版客户端已发布，更新后即可继续使用。';
    $('uText').textContent = note;
    $('uVer').innerHTML = '当前版本 <b>v' + VERSION + '</b> · 需要 v' + cfg.min + ' 及以上';

    var url = (cfg.download || {})[PLATFORM] || '';
    var btn = $('uBtn');
    var hint = $('uHint');

    if (!url) {
      btn.textContent = '联系客服获取安装包';
      btn.disabled = true;
      hint.hidden = false;
      hint.textContent = '当前版本已停止服务，请向客服索取最新安装包。';
      return;
    }

    btn.addEventListener('click', function () {
      btn.disabled = true;
      btn.textContent = '正在打开下载…';
      openExternal(url);
    }, { once: true });
  }

  function openExternal(url) {
    if (window.__TAURI__ && window.__TAURI__.core && window.__TAURI__.core.invoke) {
      window.__TAURI__.core.invoke('open_external', { url: url }).catch(function () {
        window.location.href = url;
      });
      return;
    }
    window.location.href = url;
  }

  function showLines(entries, retryHint) {
    stopBar();
    $('status').textContent = '';
    $('linePanel').hidden = false;
    $('lText').textContent = retryHint
      ? '上一条线路没有打开，换一条试试。'
      : '请选择一条线路进入。';

    var list = $('lList');
    list.innerHTML = '';

    entries.forEach(function (entry) {
      var btn = document.createElement('button');
      btn.className = 'line-item';
      btn.type = 'button';

      var name = document.createElement('span');
      name.textContent = hostOf(entry).replace(/\.nowuse-ai\.com$/, '');
      var tag = document.createElement('small');
      tag.textContent = '进入';

      btn.appendChild(name);
      btn.appendChild(tag);
      btn.addEventListener('click', function () { go(entry); });
      list.appendChild(btn);
    });
  }

  function saveLast(entry) {
    try {
      localStorage.setItem(LAST_KEY, JSON.stringify({ entry: entry, ts: Date.now() }));
    } catch (e) { /* 隐私模式下忽略 */ }
  }

  function readLast() {
    try {
      var raw = localStorage.getItem(LAST_KEY);
      return raw ? JSON.parse(raw) : null;
    } catch (e) { return null; }
  }

  function go(entry) {
    saveLast(entry);
    setStatus('正在进入 ' + hostOf(entry));
    window.location.href = entry;
  }

  function start() {
    $('foot').textContent = 'v' + VERSION + ' · ' + (IS_ANDROID ? 'Android' : 'Windows');

    loadConfig().then(function (cfg) {
      cfg = cfg || FALLBACK;

      if (cfg.min && cmpVersion(VERSION, cfg.min) < 0) {
        showUpdate(cfg);
        return;
      }

      var entries = (cfg.entries && cfg.entries.length) ? cfg.entries : FALLBACK.entries;
      var last = readLast();

      // 90 秒内又回到启动页，说明上一条线路没打开，直接让用户换线。
      if (last && Date.now() - (last.ts || 0) < 60000) {
        showLines(entries, true);
        return;
      }

      go(entries[0]);
    });
  }

  start();
})();
</script>
</body>
</html>
